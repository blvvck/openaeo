model workspace_members {
  id                                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id                              String     @db.Uuid
  user_id                                   String     @db.VarChar(255)
  role                                      String     @default("member") @db.VarChar(20)
  invited_by                                String?    @db.VarChar(255)
  joined_at                                 DateTime?  @default(now()) @db.Timestamp(6)
  users_workspace_members_invited_byTousers users?     @relation("workspace_members_invited_byTousers", fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "workspace_members_invited_by_users_id_fk")
  users_workspace_members_user_idTousers    users      @relation("workspace_members_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workspace_members_user_id_users_id_fk")
  workspaces                                workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workspace_members_workspace_id_workspaces_id_fk")

  @@unique([workspace_id, user_id], map: "idx_workspace_members_workspace_user")
  @@index([user_id], map: "idx_workspace_members_user")
}

